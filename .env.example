# Leave DATABASE_URL unset to use process-local metadata and vector storage.
# PostgreSQL must have the pgvector extension available (replace values locally):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/documents

# Leave REDIS_URL unset for a process-local query embedding cache.
# REDIS_URL=redis://localhost:6379/0
EMBEDDING_CACHE_TTL_SECONDS=300
EMBEDDING_CACHE_NAMESPACE=query-embeddings:v1

# Expired indexing work can be reclaimed after a crashed request.
INDEXING_LEASE_SECONDS=300

# Hashing is deterministic and key-free for local development.
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIMENSIONS=256

# Semantic provider example. Never commit the real key.
# EMBEDDING_PROVIDER=openai
# EMBEDDING_DIMENSIONS=1536
# OPENAI_API_KEY=replace-locally
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1
# EMBEDDING_TIMEOUT_SECONDS=20

# Citation-backed Q&A defaults to deterministic extractive answers.
ANSWER_PROVIDER=extractive
ANSWER_MIN_RELEVANCE=0.05
# To synthesize grounded answers with an OpenAI-compatible endpoint:
# ANSWER_PROVIDER=openai
# OPENAI_ANSWER_MODEL=gpt-4.1-mini
# ANSWER_TIMEOUT_SECONDS=30
