# Leave DATABASE_URL unset to use process-local document metadata storage.
# PostgreSQL example (replace values locally):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/documents

# Hashing is deterministic and key-free for local development.
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIMENSIONS=256

# Semantic provider example. Never commit the real key.
# EMBEDDING_PROVIDER=openai
# EMBEDDING_DIMENSIONS=1536
# OPENAI_API_KEY=replace-locally
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1
# EMBEDDING_TIMEOUT_SECONDS=20
